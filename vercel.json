{
  "version": 2,
  "builds": [
    {
      "src": "tera-mentor-literario-main/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "tera-mentor-literario-main/**"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "tera-mentor-literario-main/server.js" }
  ]
}
